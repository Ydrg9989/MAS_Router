# Copy to .env and fill in. .env is gitignored.

# ---- OpenRouter (primary provider for all agents) ----
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Attribution headers OpenRouter uses for ranking/analytics (optional).
OPENROUTER_REFERER=https://example.invalid/mas-harness
OPENROUTER_TITLE=MAS

# ---- Hard spend guard ----
# The client refuses to issue a request that would push the run's cumulative
# cost above MAS_RUN_BUDGET_USD, and refuses to start if today's spend
# (tracked in data/runs/spend_ledger.jsonl) already exceeds the daily cap.
MAS_RUN_BUDGET_USD=75.0
MAS_DAILY_BUDGET_USD=150.0

# ---- Local vLLM (optional; same code path as OpenRouter) ----
# Only used by pools whose provider is "vllm".
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=EMPTY

# ---- HuggingFace cache (datasets are already present here) ----
HF_HOME=/data/yiderigun/.cache/huggingface
